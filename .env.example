# Copy to .env and change every value marked CHANGE_ME before any non-local use.

# --- Django ---
# Also signs login tokens (JWT): keep it at least 50 random characters.
DJANGO_SECRET_KEY=CHANGE_ME-dev-only-secret-key-not-for-production-use-0123456789
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Owner role: runs migrations. Superuser inside the container only.
POSTGRES_DB=spatial
POSTGRES_USER=spatial_owner
POSTGRES_PASSWORD=CHANGE_ME-owner
# App role: used by the running app. NOT a superuser, so row-level security
# (Phase 1) applies to it. Created by db/init/01-roles.sh.
APP_DB_USER=spatial_app
APP_DB_PASSWORD=CHANGE_ME-app
DB_HOST=db
DB_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Encryption of stored third-party API keys (basemaps) ---
# Long random string. If empty, derived from DJANGO_SECRET_KEY (then rotating
# that key makes stored API keys unreadable, and they must be re-entered).
FIELD_ENCRYPTION_KEY=

# --- Coordinate reference systems (Phase 2) ---
# Seed value for the system default CRS. Admins can change it any time in the app;
# this only applies to a brand-new installation.
INITIAL_DEFAULT_CRS=EPSG:2136

# --- .spp project files (Phase 8) ---
# Organisation keys wrap the per-file data keys. Every deployment that must open
# the same .spp files needs the same keys. Format: key_id:base64key,key_id2:base64key2
# The first key is used for new files; the rest are kept for decryption only.
# Leave empty until Phase 8. Never commit real keys.
SPP_ORG_KEYS=

# --- Ports (host side) ---
WEB_PORT=5173
API_PORT=8000
MARTIN_PORT=3000
TITILER_PORT=8001
DB_HOST_PORT=5433
